{
  "info": {
    "name": "OpenWeather (boilerplate-d)",
    "description": "Requests used by scripts.js. Run 'Geocode city' first: it saves lat/lon into collection variables that 'Current weather' uses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "city", "value": "Warszawa" },
    { "key": "lat", "value": "" },
    { "key": "lon", "value": "" }
  ],
  "item": [
    {
      "name": "Geocode city",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://api.openweathermap.org/geo/1.0/direct?q={{city}}&limit=1&appid={{apiKey}}",
          "protocol": "http",
          "host": ["api", "openweathermap", "org"],
          "path": ["geo", "1.0", "direct"],
          "query": [
            { "key": "q", "value": "{{city}}" },
            { "key": "limit", "value": "1" },
            { "key": "appid", "value": "{{apiKey}}" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('Returns at least one city', () => {",
              "  pm.expect(body).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "pm.test('City has lat, lon, name and country', () => {",
              "  const c = body[0];",
              "  pm.expect(c.lat).to.be.a('number');",
              "  pm.expect(c.lon).to.be.a('number');",
              "  pm.expect(c.name).to.be.a('string');",
              "  pm.expect(c.country).to.be.a('string');",
              "});",
              "",
              "if (Array.isArray(body) && body.length) {",
              "  pm.collectionVariables.set('lat', body[0].lat);",
              "  pm.collectionVariables.set('lon', body[0].lon);",
              "  console.log('Polish name:', body[0].local_names?.pl ?? body[0].name);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Current weather",
      "request": {
        "method": "GET",
        "url": {
          "raw": "https://api.openweathermap.org/data/4.0/onecall/current?lat={{lat}}&lon={{lon}}&units=metric&lang=pl&appid={{apiKey}}",
          "protocol": "https",
          "host": ["api", "openweathermap", "org"],
          "path": ["data", "4.0", "onecall", "current"],
          "query": [
            { "key": "lat", "value": "{{lat}}" },
            { "key": "lon", "value": "{{lon}}" },
            { "key": "units", "value": "metric" },
            { "key": "lang", "value": "pl" },
            { "key": "appid", "value": "{{apiKey}}" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('Has data[0] with the fields scripts.js reads', () => {",
              "  pm.expect(body.data).to.be.an('array').that.is.not.empty;",
              "  const cur = body.data[0];",
              "  pm.expect(cur.temp).to.be.a('number');",
              "  pm.expect(cur.feels_like).to.be.a('number');",
              "  pm.expect(cur.pressure).to.be.a('number');",
              "  pm.expect(cur.humidity).to.be.a('number');",
              "  pm.expect(cur.weather[0].description).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
